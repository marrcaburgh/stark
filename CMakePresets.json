{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base Configuration",
      "description": "Common settings for all builds",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0 -Wall -Wextra -pedantic"
      }
    },
    {
      "name": "release-base",
      "inherits": "base",
      "displayName": "Base Release Configuration",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-g -gdwarf-4 -O3 -march=native -DNDEBUG"
      }
    },
    {
      "name": "release-hash_table",
      "inherits": "release-base",
      "displayName": "Release - hash_table",
      "cacheVariables": {
        "COMPILE_HASH_TABLE": "ON"
      }
    },
    {
      "name": "release-cli_opts",
      "inherits": "release-base",
      "displayName": "Release - cli_opts",
      "cacheVariables": {
        "COMPILE_HASH_TABLE": "ON",
        "COMPILE_CLI_OPTS": "ON"
      }
    }

  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release-cli_opts",
      "configurePreset": "release-cli_opts"
    },
    {
      "name": "release-hash_table",
      "configurePreset": "release-hash_table"
    }
  ]
}
